  "$defs": {
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "action",
        "result",
        "score",
        "reason",
        "improvement",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "action": {
          "enum": [
            "check",
            "skip"
          ]
        },
        "result": {
          "enum": [
            "scored",
            "unverified",
            "not_applicable"
          ]
        },
        "score": {
          "enum": [
            0,
            1,
            2,
            null
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 260,
          "pattern": "\\S"
        },
        "improvement": {
          "type": "string",
          "maxLength": 160
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "artifact_id",
              "locator"
            ],
            "properties": {
              "artifact_id": {
                "type": "string",
                "pattern": "^artifact:[a-f0-9]{64}$"
              },
              "locator": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "\\S"
              }
            }
          },
          "minItems": 0,
          "maxItems": 3
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "result": {
                "const": "scored"
              }
            }
          },
          "then": {
            "properties": {
              "action": {
                "const": "check"
              },
              "score": {
                "enum": [
                  0,
                  1,
                  2
                ]
              },
              "evidence": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "result": {
                "const": "unverified"
              }
            }
          },
          "then": {
            "properties": {
              "action": {
                "const": "check"
              },
              "score": {
                "const": null
              },
              "improvement": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "\\S"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "result": {
                "const": "not_applicable"
              }
            }
          },
          "then": {
            "properties": {
              "action": {
                "const": "skip"
              },
              "score": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "score": {
                "enum": [
                  0,
                  1
                ]
              }
            }
          },
          "then": {
            "properties": {
              "improvement": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "\\S"
              }
            }
          }
        }
      ]
    }
  }
