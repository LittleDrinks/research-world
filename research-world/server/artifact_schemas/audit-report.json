{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "target_artifact_id",
    "summary",
    "sections",
    "conclusion",
    "dimensions",
    "execution"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "\\S"
    },
    "target_artifact_id": {
      "type": "string",
      "pattern": "^artifact:[a-f0-9]{64}$"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400,
      "pattern": "\\S"
    },
    "sections": {
      "type": "array",
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "title",
            "markdown",
            "evidence"
          ],
          "properties": {
            "id": {
              "const": "scope"
            },
            "title": {
              "const": "范围与方法"
            },
            "markdown": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1200,
              "pattern": "\\S"
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "artifact_id",
                  "locator"
                ],
                "properties": {
                  "artifact_id": {
                    "type": "string",
                    "pattern": "^artifact:[a-f0-9]{64}$"
                  },
                  "locator": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160,
                    "pattern": "\\S"
                  }
                }
              },
              "minItems": 0,
              "maxItems": 8
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "title",
            "markdown",
            "evidence",
            "checks"
          ],
          "properties": {
            "id": {
              "const": "checks"
            },
            "title": {
              "const": "检查项"
            },
            "markdown": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1200,
              "pattern": "\\S"
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "artifact_id",
                  "locator"
                ],
                "properties": {
                  "artifact_id": {
                    "type": "string",
                    "pattern": "^artifact:[a-f0-9]{64}$"
                  },
                  "locator": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160,
                    "pattern": "\\S"
                  }
                }
              },
              "minItems": 0,
              "maxItems": 8
            },
            "checks": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "label",
                  "action",
                  "reason",
                  "result",
                  "evidence"
                ],
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "pattern": "\\S"
                  },
                  "action": {
                    "enum": [
                      "check",
                      "skip"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 240,
                    "pattern": "\\S"
                  },
                  "result": {
                    "enum": [
                      "pass",
                      "partial",
                      "fail",
                      "unverified",
                      "not_applicable"
                    ]
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "artifact_id",
                        "locator"
                      ],
                      "properties": {
                        "artifact_id": {
                          "type": "string",
                          "pattern": "^artifact:[a-f0-9]{64}$"
                        },
                        "locator": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 160,
                          "pattern": "\\S"
                        }
                      }
                    },
                    "minItems": 0,
                    "maxItems": 4
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "action": {
                          "const": "skip"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "result": {
                          "const": "not_applicable"
                        },
                        "evidence": {
                          "maxItems": 0
                        }
                      }
                    },
                    "else": {
                      "properties": {
                        "result": {
                          "enum": [
                            "pass",
                            "partial",
                            "fail",
                            "unverified"
                          ]
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "result": {
                          "enum": [
                            "pass",
                            "partial",
                            "fail"
                          ]
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "evidence": {
                          "minItems": 1
                        }
                      }
                    }
                  }
                ]
              },
              "minItems": 1,
              "maxItems": 12
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "title",
            "markdown",
            "evidence"
          ],
          "properties": {
            "id": {
              "const": "limitations"
            },
            "title": {
              "const": "缺口与下一步"
            },
            "markdown": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1200,
              "pattern": "\\S"
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "artifact_id",
                  "locator"
                ],
                "properties": {
                  "artifact_id": {
                    "type": "string",
                    "pattern": "^artifact:[a-f0-9]{64}$"
                  },
                  "locator": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160,
                    "pattern": "\\S"
                  }
                }
              },
              "minItems": 0,
              "maxItems": 8
            }
          }
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "conclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "markdown"
      ],
      "properties": {
        "verdict": {
          "enum": [
            "pass",
            "revise",
            "inconclusive"
          ]
        },
        "markdown": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400,
          "pattern": "\\S"
        }
      }
    },
    "dimensions": {
      "type": "array",
      "prefixItems": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/dimension"
            }
          ],
          "properties": {
            "id": {
              "const": "understanding"
            },
            "title": {
              "const": "问题理解"
            },
            "action": {
              "const": "check"
            },
            "result": {
              "enum": [
                "scored",
                "unverified"
              ]
            }
          },
          "x-score-anchors": [
            "对象、范围或关键前提错误。",
            "对象明确，但边界或关键变量缺失。",
            "对象、范围、变量与前提明确，区分问题和假设。"
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/dimension"
            }
          ],
          "properties": {
            "id": {
              "const": "evidence"
            },
            "title": {
              "const": "文献证据"
            }
          },
          "x-score-anchors": [
            "关键引文错误或不支持主张。",
            "部分证据已核查，仍有承重主张缺依据。",
            "承重主张均有核查过的证据及定位，引用内容与结论一致。"
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/dimension"
            }
          ],
          "properties": {
            "id": {
              "const": "directions"
            },
            "title": {
              "const": "方向质量"
            }
          },
          "x-score-anchors": [
            "方向重复、无依据或不可检验。",
            "有不同解释，但缺少可区分预测或反证。",
            "方向机制可区分，明确依据、反证和可检验预测。"
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/dimension"
            }
          ],
          "properties": {
            "id": {
              "const": "reasoning"
            },
            "title": {
              "const": "科学推理"
            },
            "action": {
              "const": "check"
            },
            "result": {
              "enum": [
                "scored",
                "unverified"
              ]
            }
          },
          "x-score-anchors": [
            "关键推导、单位、数量级或因果推断错误。",
            "主要推理成立，但存在未闭合假设或外推。",
            "关键推导、单位、量级及适用条件核查一致，结论强度匹配证据。"
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/dimension"
            }
          ],
          "properties": {
            "id": {
              "const": "plan"
            },
            "title": {
              "const": "研究计划"
            }
          },
          "x-score-anchors": [
            "缺少可执行步骤，或判据错误导致实施失效。",
            "有方法和步骤，但缺基线、对照、资源或停止判据。",
            "输入、方法、基线、对照、判据和资源明确，计划与执行分开。"
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/dimension"
            }
          ],
          "properties": {
            "id": {
              "const": "traceability"
            },
            "title": {
              "const": "表达与追溯"
            },
            "action": {
              "const": "check"
            },
            "result": {
              "enum": [
                "scored",
                "unverified"
              ]
            }
          },
          "x-score-anchors": [
            "关键结论无法追到来源或执行产物。",
            "主线可读，但部分版本、定位或执行依据缺失。",
            "表达简明，结论可追到固定版本、来源和实际执行依据。"
          ]
        }
      ],
      "items": false,
      "minItems": 6,
      "maxItems": 6
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason",
        "evidence"
      ],
      "properties": {
        "status": {
          "enum": [
            "executed",
            "not_executed",
            "unverified",
            "not_applicable"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "\\S"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "artifact_id",
              "locator"
            ],
            "properties": {
              "artifact_id": {
                "type": "string",
                "pattern": "^artifact:[a-f0-9]{64}$"
              },
              "locator": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "\\S"
              }
            }
          },
          "minItems": 0,
          "maxItems": 3
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "executed"
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "六维审计",
  "description": "固定六维评分判据；check须核查，skip仅表示不适用。未核验不记分，评分不代表实验已执行。逐维证据必须来自被审材料或本次实际核验。",
  "x-max-reading-chars": 5000,
  "allOf": [
    {
      "if": {
        "properties": {
          "conclusion": {
            "properties": {
              "verdict": {
                "const": "pass"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "sections": {
            "prefixItems": [
              {},
              {
                "properties": {
                  "checks": {
                    "items": {
                      "properties": {
                        "result": {
                          "enum": [
                            "pass",
                            "not_applicable"
                          ]
                        }
                      }
                    },
                    "contains": {
                      "properties": {
                        "action": {
                          "const": "check"
                        }
                      }
                    },
                    "minContains": 1
                  }
                }
              }
            ]
          },
          "dimensions": {
            "items": {
              "properties": {
                "result": {
                  "enum": [
                    "scored",
                    "not_applicable"
                  ]
                },
                "score": {
                  "enum": [
                    2,
                    null
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "dimensions": {
            "contains": {
              "properties": {
                "score": {
                  "enum": [
                    0,
                    1
                  ]
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "conclusion": {
            "properties": {
              "verdict": {
                "const": "revise"
              }
            }
          }
        }
      }
    }
  ],
