{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research.world/schemas/agent.schema.json",
  "title": "AgentSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "endpoint", "model", "instructions"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "name": {"type": "string", "minLength": 1},
    "endpoint": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "instructions": {"type": "string", "minLength": 1},
    "skills": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true,
      "default": []
    },
    "tools": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true,
      "default": []
    },
    "connectors": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true,
      "default": []
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reasoning_effort": {"enum": ["low", "medium", "high", "xhigh"]},
        "sandbox": {"enum": ["read-only", "workspace-write"]},
        "max_rounds": {"type": "integer", "minimum": 1, "maximum": 64},
        "token_budget": {"type": "integer", "minimum": 1}
      }
    }
  }
}
