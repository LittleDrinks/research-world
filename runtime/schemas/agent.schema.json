{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research.world/schemas/agent.schema.json",
  "title": "AgentSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "runtime", "endpoint", "model", "instructions"],
  "allOf": [
    {
      "if": {"properties": {"endpoint": {"const": "codex"}}},
      "then": {"properties": {"runtime": {"properties": {"id": {"const": "codex"}}}}}
    },
    {
      "if": {"properties": {"runtime": {"properties": {"id": {"const": "codex"}}}}},
      "then": {"properties": {"endpoint": {"const": "codex"}}}
    }
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "name": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "realm"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "realm": {"type": "string", "minLength": 1, "pattern": "\\S"}
      }
    },
    "endpoint": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "model": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "instructions": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "skills": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "pattern": "\\S"},
      "uniqueItems": true,
      "default": []
    },
    "tools": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "pattern": "\\S"},
      "uniqueItems": true,
      "default": []
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reasoning_effort": {"enum": ["low", "medium", "high", "xhigh"]},
        "sandbox": {"enum": ["read-only", "workspace-write"]},
        "max_rounds": {"type": "integer", "minimum": 1, "maximum": 64},
        "token_budget": {"type": "integer", "minimum": 1}
      }
    }
  }
}
